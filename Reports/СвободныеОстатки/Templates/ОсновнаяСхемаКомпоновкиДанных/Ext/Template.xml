		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиТоваровОстатки.Номенклатура КАК Номенклатура,
	ОстаткиТоваровОстатки.Склад КАК Склад,
	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК НаСкладе,
	ЕСТЬNULL(РезервыОстатки.КоличествоОстаток, 0) КАК Зарезервировано,
	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(РезервыОстатки.КоличествоОстаток, 0) КАК Свободно
ИЗ
	РегистрНакопления.ОстаткиТоваров.Остатки(&amp;Дата, ) КАК ОстаткиТоваровОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Резервы.Остатки(&amp;Дата, ) КАК РезервыОстатки
		ПО ОстаткиТоваровОстатки.Номенклатура = РезервыОстатки.Номенклатура
			И ОстаткиТоваровОстатки.Склад = РезервыОстатки.Склад</query>
